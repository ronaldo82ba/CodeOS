{
  "service": "codesvc.auth",
  "version": "0.1",
  "methods": [
    {
      "method": "Auth.RequestPermission",
      "payload": {
        "app_id": "string",
        "permission": "string"
      },
      "response": {
        "granted": "boolean"
      },
      "errors": ["IPC_INVALID_PAYLOAD"]
    },
    {
      "method": "Auth.CheckPermission",
      "payload": {
        "app_id": "string",
        "permission": "string"
      },
      "response": {
        "granted": "boolean"
      },
      "errors": ["IPC_INVALID_PAYLOAD"]
    }
  ],
  "events": [
    {
      "method": "Auth.PermissionChanged",
      "payload": {
        "app_id": "string",
        "permission": "string",
        "granted": "boolean"
      }
    }
  ]
}
